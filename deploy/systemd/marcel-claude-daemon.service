# Claude Code's background-session supervisor, in its own cgroup (SP6). `claude --bg` connects to it
# instead of starting one inside the runner, where a runner restart would kill every session.
# Stopping this unit stops every background session (brain and workers): restart it only on purpose.
# After a Claude Code update, prefer `claude respawn --all`.
[Unit]
Description=Claude Code background service (supervisor for Marcel's claude sessions)

[Service]
ExecStart=%h/.local/bin/claude daemon run
# node 22 for the marcel plugin's channel server (plugin.json runs a bare `node`).
Environment=PATH=%h/marcel/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# MARCEL_HARRY_TOKEN only, copied from deploy/.env.local by `make install`.
EnvironmentFile=-%h/.config/marcel/session.env
# 2.1.289's daemon "runs on demand and exits when the last client disconnects": keep it up.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

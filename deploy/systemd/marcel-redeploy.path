# Runs marcel-redeploy.service when the hub writes the flag for an approved, merged self-change
# (.claude/rules/self-modification.md). `make install` enables it once deploy/redeploy.sh exists (S-11.2).
[Unit]
Description=Watch for Marcel's redeploy flag

[Path]
PathChanged=%h/marcel/state/redeploy.flag
Unit=marcel-redeploy.service

[Install]
WantedBy=default.target

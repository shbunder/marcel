{
  "permissions": {
    "allow": [
      "Workflow"
    ],
    "deny": [
      "Bash(docker restart:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker-compose restart:*)",
      "Bash(systemctl restart:*)",
      "Bash(systemctl --user restart:*)"
    ]
  },
  "crossSessionInbound": "refuse",
  "subagentPromptCacheTtl": "1h"
}
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-restricted.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Build board: https://claude.ai/artifact/1V2swuomSbb9r1cB23Y2eh  (/board for status, /story to start one)'",
            "timeout": 2
          }
        ]
      }
    ]
  }
}

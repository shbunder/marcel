{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marcel.invalid/contracts/events.schema.json",
  "title": "Marcel hub — app WebSocket events",
  "description": "Every frame the hub sends on GET /ws is one Event. `id` increases by one per user across all event types; reconnect with `?since=<last id>` to replay what you missed. If `since` is older than the hub keeps, the first frame is `resync.required` and the app re-fetches over REST. Payloads reuse the app API's schemas (app-api.yaml). The app sends nothing except WebSocket pings.",
  "$ref": "#/$defs/Event",
  "$defs": {
    "Event": {
      "oneOf": [
        { "$ref": "#/$defs/Hello" },
        { "$ref": "#/$defs/ResyncRequired" },
        { "$ref": "#/$defs/MessageCreated" },
        { "$ref": "#/$defs/ConversationCreated" },
        { "$ref": "#/$defs/TaskCreated" },
        { "$ref": "#/$defs/TaskUpdated" },
        { "$ref": "#/$defs/TaskEventAppended" },
        { "$ref": "#/$defs/ApprovalCreated" },
        { "$ref": "#/$defs/ApprovalResolved" },
        { "$ref": "#/$defs/ArtifactCreated" },
        { "$ref": "#/$defs/ArtifactUpdated" },
        { "$ref": "#/$defs/ProjectCreated" },
        { "$ref": "#/$defs/ProjectUpdated" },
        { "$ref": "#/$defs/TaskMoved" },
        { "$ref": "#/$defs/ArtifactMoved" },
        { "$ref": "#/$defs/BrainRollover" },
        { "$ref": "#/$defs/AgentStateChanged" },
        { "$ref": "#/$defs/UsageUpdated" }
      ]
    },
    "Envelope": {
      "type": "object",
      "required": ["id", "type", "at", "data"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "type": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "data": {}
      }
    },
    "Hello": {
      "description": "First frame after connecting. `last_event_id` is where replay ended. Its own `id` is 0 and is not part of the event sequence.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "hello" },
        "data": {
          "type": "object",
          "required": ["last_event_id", "replayed"],
          "additionalProperties": false,
          "properties": {
            "last_event_id": { "type": "integer", "minimum": 0 },
            "replayed": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        { "id": 0, "type": "hello", "at": "2026-10-04T18:40:00Z", "data": { "last_event_id": 1288, "replayed": 3 } }
      ]
    },
    "ResyncRequired": {
      "description": "The requested `since` is older than the hub keeps. Re-fetch over REST, then reconnect with `since = last_event_id`. Its own `id` is 0 and is not part of the event sequence.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "resync.required" },
        "data": {
          "type": "object",
          "required": ["last_event_id"],
          "additionalProperties": false,
          "properties": { "last_event_id": { "type": "integer", "minimum": 0 } }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        { "id": 0, "type": "resync.required", "at": "2026-10-04T18:40:00Z", "data": { "last_event_id": 1288 } }
      ]
    },
    "MessageCreated": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "message.created" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Message" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1289,
          "type": "message.created",
          "at": "2026-10-04T18:05:02Z",
          "data": {
            "id": "msg_01J9ZQZ8",
            "conversation_id": "cnv_main_marcel",
            "role": "agent",
            "kind": "milestone",
            "milestone": { "task_id": "tsk_01J9ZQ5", "task_title": "Fix the flaky login test", "event": "started", "location": "cloud" },
            "task_id": "tsk_01J9ZQ5",
            "created_at": "2026-10-04T18:05:02Z"
          }
        }
      ]
    },
    "ConversationCreated": {
      "description": "A side thread was opened, possibly from another device.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "conversation.created" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Conversation" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1290,
          "type": "conversation.created",
          "at": "2026-10-04T18:10:00Z",
          "data": { "id": "cnv_side_01J9ZR0", "agent_id": "agt_marcel", "kind": "side", "parent_message_id": "msg_01J9ZQZ8", "created_at": "2026-10-04T18:10:00Z" }
        }
      ]
    },
    "TaskCreated": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "task.created" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Task" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1291,
          "type": "task.created",
          "at": "2026-10-04T18:06:00Z",
          "data": {
            "id": "tsk_01J9ZQ6", "agent_id": "agt_marcel", "project_id": "prj_inbox", "title": "Check disk usage of all Docker volumes",
            "location": "nuc", "state": "starting", "model": "sonnet", "origin": "marcel",
            "created_at": "2026-10-04T18:06:00Z", "updated_at": "2026-10-04T18:06:00Z"
          }
        }
      ]
    },
    "TaskUpdated": {
      "description": "Any change to a task: state, summary, waiting_for, artifact_count. Carries the whole task.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "task.updated" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Task" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1295,
          "type": "task.updated",
          "at": "2026-10-04T18:06:40Z",
          "data": {
            "id": "tsk_01J9ZQ6", "agent_id": "agt_marcel", "project_id": "prj_inbox", "title": "Check disk usage of all Docker volumes",
            "location": "nuc", "state": "needs_you", "model": "sonnet", "origin": "marcel",
            "waiting_for": "Permission to run `docker system df -v`.", "approval_ids": ["apr_01J9ZR2"],
            "created_at": "2026-10-04T18:06:00Z", "updated_at": "2026-10-04T18:06:40Z"
          }
        }
      ]
    },
    "TaskEventAppended": {
      "description": "One new transcript or hub event on a task. Every device gets it; the app may ignore tasks it is not showing.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "task.event" },
        "data": { "$ref": "app-api.yaml#/components/schemas/TaskEvent" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1294,
          "type": "task.event",
          "at": "2026-10-04T18:06:39Z",
          "data": { "task_id": "tsk_01J9ZQ6", "seq": 12, "type": "tool_call", "at": "2026-10-04T18:06:39Z", "data": { "tool_use_id": "toolu_01VQ3n8ZkC2xH7d4Rb5Tq9Lw", "tool": "Bash", "summary": "docker system df -v" } }
        }
      ]
    },
    "ApprovalCreated": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "approval.created" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Approval" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1296,
          "type": "approval.created",
          "at": "2026-10-04T18:06:40Z",
          "data": { "id": "apr_01J9ZR2", "task_id": "tsk_01J9ZQ6", "tool": "Bash", "summary": "Run `docker system df -v`", "state": "open", "created_at": "2026-10-04T18:06:40Z" }
        }
      ]
    },
    "ApprovalResolved": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "approval.resolved" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Approval" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1297,
          "type": "approval.resolved",
          "at": "2026-10-04T18:07:05Z",
          "data": {
            "id": "apr_01J9ZR2", "task_id": "tsk_01J9ZQ6", "tool": "Bash", "summary": "Run `docker system df -v`",
            "state": "approved", "answered_via": "app", "created_at": "2026-10-04T18:06:40Z", "answered_at": "2026-10-04T18:07:05Z"
          }
        }
      ]
    },
    "ArtifactCreated": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "artifact.created" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Artifact" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1310,
          "type": "artifact.created",
          "at": "2026-10-04T18:31:00Z",
          "data": {
            "id": "art_01J9ZT1", "task_id": "tsk_01J9ZQ5", "project_id": "prj_01J9ZM1", "kind": "pr", "title": "Fix flaky login test: wait on the session cookie", "current_version": 1,
            "url": "https://github.com/shbunder/marcel/pull/14", "pr": { "number": 14, "state": "open", "checks": "pending" },
            "created_at": "2026-10-04T18:31:00Z", "updated_at": "2026-10-04T18:31:00Z"
          }
        }
      ]
    },
    "ArtifactUpdated": {
      "description": "A living artifact got a new version (B-34): v2 and later. The app refreshes every card and open viewer of it; it never shows a second item-get banner.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "artifact.updated" },
        "data": {
          "type": "object",
          "required": ["artifact", "version"],
          "additionalProperties": false,
          "properties": {
            "artifact": { "$ref": "app-api.yaml#/components/schemas/Artifact" },
            "version": { "$ref": "app-api.yaml#/components/schemas/ArtifactVersion" }
          }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 2104,
          "type": "artifact.updated",
          "at": "2026-10-12T08:14:00Z",
          "data": {
            "artifact": {
              "id": "art_01JA0B1", "task_id": "tsk_01JA0A9", "project_id": "prj_01JA0A1", "kind": "doc", "title": "Energy offers compared",
              "current_version": 3, "updated_by": "Energy contracts", "content_type": "text/markdown", "size_bytes": 3120,
              "created_at": "2026-10-09T20:00:00Z", "updated_at": "2026-10-12T08:14:00Z"
            },
            "version": {
              "artifact_id": "art_01JA0B1", "version": 3, "summary": "Added the Engie offer; Luminus is still the cheapest.",
              "author": "Energy contracts", "task_id": "tsk_01JA0A9", "content_type": "text/markdown", "size_bytes": 3120,
              "created_at": "2026-10-12T08:14:00Z"
            }
          }
        }
      ]
    },
    "ProjectCreated": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "project.created" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Project" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1990,
          "type": "project.created",
          "at": "2026-10-08T19:00:00Z",
          "data": {
            "id": "prj_01JA0A1", "agent_id": "agt_marcel", "slug": "energy", "name": "Energy contracts",
            "goal": "Find a cheaper gas and electricity contract before the renewal on 1 December.",
            "board_artifact_id": "art_01JA0A2", "archived": false, "counts": { "working": 0, "needs_you": 0, "done_7d": 0 },
            "created_at": "2026-10-08T19:00:00Z", "updated_at": "2026-10-08T19:00:00Z"
          }
        }
      ]
    },
    "ProjectUpdated": {
      "description": "Any change to a project or its counts: renamed, archived, a task in it changed state.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "project.updated" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Project" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 2105,
          "type": "project.updated",
          "at": "2026-10-12T08:14:05Z",
          "data": {
            "id": "prj_01JA0A1", "agent_id": "agt_marcel", "slug": "energy", "name": "Energy contracts",
            "board_artifact_id": "art_01JA0A2", "archived": false, "counts": { "working": 1, "needs_you": 1, "done_7d": 2 },
            "created_at": "2026-10-08T19:00:00Z", "updated_at": "2026-10-12T08:14:05Z"
          }
        }
      ]
    },
    "TaskMoved": {
      "description": "A task was filed under another project (B-31). Both projects follow with `project.updated`.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "task.moved" },
        "data": {
          "type": "object",
          "required": ["task_id", "from_project_id", "to_project_id"],
          "additionalProperties": false,
          "properties": {
            "task_id": { "type": "string" },
            "from_project_id": { "type": "string" },
            "to_project_id": { "type": "string" }
          }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        { "id": 2001, "type": "task.moved", "at": "2026-10-09T07:30:00Z", "data": { "task_id": "tsk_01JA0A9", "from_project_id": "prj_inbox", "to_project_id": "prj_01JA0A1" } }
      ]
    },
    "ArtifactMoved": {
      "description": "An item was pinned to another project (`POST /artifacts/{id}/move`, B-21). Both projects follow with `project.updated`. New in app API 0.5.0.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "artifact.moved" },
        "data": {
          "type": "object",
          "required": ["artifact_id", "from_project_id", "to_project_id"],
          "additionalProperties": false,
          "properties": {
            "artifact_id": { "type": "string" },
            "from_project_id": { "type": "string" },
            "to_project_id": { "type": "string" }
          }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        { "id": 2002, "type": "artifact.moved", "at": "2026-10-09T07:31:00Z", "data": { "artifact_id": "art_01JA0B1", "from_project_id": "prj_inbox", "to_project_id": "prj_01JA0A1" } }
      ]
    },
    "BrainRollover": {
      "description": "Marcel's main session was replaced by a fresh one (S-06.2). Shown in Marcel's notebook so a rollover is never silent; the notebook reads past ones from app-api.yaml `GET /agents/{agent_id}/brain/rollovers` (0.6.0), so one from before the phone was listening is shown too.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "brain.rollover" },
        "data": {
          "type": "object",
          "required": ["agent_id", "reason", "kept"],
          "additionalProperties": false,
          "properties": {
            "agent_id": { "type": "string" },
            "reason": {
              "type": "string",
              "enum": ["context_full", "crashed", "daily", "manual"],
              "description": "Why: its context was full, it crashed, the daily fresh start, or you asked."
            },
            "kept": {
              "type": "string",
              "description": "What the new session starts with, in plain words."
            }
          }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 2200, "type": "brain.rollover", "at": "2026-10-12T04:00:00Z",
          "data": { "agent_id": "agt_marcel", "reason": "daily", "kept": "Your notes, the last 40 messages, 3 open threads and the project list." }
        }
      ]
    },
    "AgentStateChanged": {
      "description": "What the avatar should show (B-28). Sent on change only.",
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "agent.state" },
        "data": {
          "type": "object",
          "required": ["agent_id", "state"],
          "additionalProperties": false,
          "properties": {
            "agent_id": { "type": "string" },
            "state": { "$ref": "app-api.yaml#/components/schemas/AgentState" }
          }
        }
      },
      "unevaluatedProperties": false,
      "examples": [
        { "id": 1298, "type": "agent.state", "at": "2026-10-04T18:07:05Z", "data": { "agent_id": "agt_marcel", "state": { "kind": "working", "active_tasks": 2 } } }
      ]
    },
    "UsageUpdated": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "properties": {
        "type": { "const": "usage.updated" },
        "data": { "$ref": "app-api.yaml#/components/schemas/Usage" }
      },
      "unevaluatedProperties": false,
      "examples": [
        {
          "id": 1300,
          "type": "usage.updated",
          "at": "2026-10-04T18:40:00Z",
          "data": {
            "five_hour": { "used_pct": 91.0, "resets_at": "2026-10-04T21:00:00Z" },
            "weekly": { "used_pct": 48.2, "resets_at": "2026-10-07T09:00:00Z" },
            "source": "statusline", "stale": false,
            "guard": { "active": true, "reason": "Plan usage is at 91 %. New tasks wait until 23:00.", "queued": 2 }
          }
        }
      ]
    }
  }
}

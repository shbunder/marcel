<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- marcel:// links: pushes and the ntfy app open marcel://task/<id> and the others (S-12.10, LinkRouter). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>marcel</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>marcel</string>
			</array>
		</dict>
	</array>
	<!-- The app icon: loose PNGs drawn by shared/brand/app-icon/generate.py, in Marcel/App/AppIcon/. Not an asset
	     catalog: actool cannot compile one on a Mac without the iOS platform component (ios/README.md). -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon20x20</string>
				<string>AppIcon29x29</string>
				<string>AppIcon40x40</string>
				<string>AppIcon60x60</string>
			</array>
		</dict>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The mock hub (127.0.0.1:7499) and a hub on the home network speak plain HTTP. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Notification Service Extension (S-22.16): opens pushes sealed for this phone (ios/NotificationService/). -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.usernotifications.service</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).NotificationService</string>
	</dict>
	<!-- The Keychain group it shares with the app (Config/NotificationService.entitlements). -->
	<key>MarcelPushKeychainGroup</key>
	<string>$(AppIdentifierPrefix)marcel.push</string>
</dict>
</plist>

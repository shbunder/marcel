{
  "name": "marcel-channel",
  "version": "0.1.0",
  "private": true,
  "description": "Marcel channel server: carries messages and permission prompts between a Claude Code session and the hub.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
